{
  "cleanUrls": true,
  "rewrites": [
    { "source": "/imovel/:ref", "destination": "/api/imovel?ref=:ref" },
    { "source": "/sitemap.xml", "destination": "/api/sitemap" }
  ],
  "headers": [
    { "source": "/assets/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=3600" }] }
  ]
}
